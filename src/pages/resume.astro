---
import BaseLayout from "../layouts/BaseLayout.astro";
import { assetPath, site } from "../data/site";
import {
  resumeEducation,
  resumeExperience,
  resumeFocusOptions,
  resumeLeadership,
  resumeProfile,
  resumeProjects,
  resumeSkillGroups,
  systemLayers,
} from "../data/resume";

const homeUrl = assetPath("");
const totalEvidence =
  1 + resumeProjects.length + 1 + resumeLeadership.length;

const skillAccentClasses = {
  yellow: "bg-yellow text-ink",
  white: "bg-white text-ink",
  coral: "bg-coral text-ink",
  blue: "bg-blue text-white",
} as const;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<BaseLayout
  title={`${site.name} | Interactive Resume`}
  description={`Explore ${site.name}'s experience across enterprise AI, backend engineering, full-stack delivery, and leadership.`}
>
  <header
    class="resume-screen-only sticky top-0 z-50 border-b-[3px] border-ink bg-paper"
    data-no-print
  >
    <nav
      class="page-shell flex min-h-[4.75rem] items-center justify-between gap-3"
      aria-label="Resume navigation"
    >
      <a class="group flex min-w-0 items-center gap-3 no-underline" href={homeUrl}>
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center border-[3px] border-ink bg-blue font-display text-sm font-black text-white shadow-[3px_3px_0_#111] transition-transform group-hover:-translate-y-0.5"
          aria-hidden="true"
        >
          WA
        </span>
        <span class="hidden font-display text-sm font-black uppercase sm:block">
          Back to portfolio
        </span>
        <span class="font-display text-sm font-black uppercase sm:hidden">Portfolio</span>
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        <a
          class="brutal-button min-h-11 px-3 py-2 text-xs sm:px-4 sm:text-sm"
          href={site.resumeUrl}
          download
        >
          <span class="sm:hidden">PDF</span>
          <span class="hidden sm:inline">Download PDF</span>
        </a>
        <button
          class="brutal-button brutal-button--yellow min-h-11 px-3 py-2 text-xs sm:px-4 sm:text-sm"
          type="button"
          data-print-button
        >
          Print
        </button>
      </div>
    </nav>
  </header>

  <main id="main-content" tabindex="-1" data-resume-app>
    <article class="resume-document resume-print-only hidden" aria-label="Printable resume">
      <section class="print-page print-page-one">
        <header class="print-resume-header">
          <h1>{site.name}</h1>
          <p class="print-role-line">{resumeProfile.roles.join(" | ")}</p>
          <p class="print-contact-line">
            <span>{site.email}</span>
            <span>{resumeProfile.phone}</span>
            <span>linkedin.com/in/wan-muhammad-adam-74409427a</span>
            <span>github.com/WanAdamm</span>
          </p>
        </header>

        <section class="print-resume-section">
          <h2>Professional Summary</h2>
          <p>{resumeProfile.summary}</p>
        </section>

        <section class="print-resume-section">
          <h2>Technical Skills</h2>
          <div class="print-skill-grid">
            {
              resumeSkillGroups.map((group) => (
                <div class="print-skill-row">
                  <h3>{group.title}</h3>
                  <p>{group.skills.map((item) => item.name).join(", ")}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section class="print-resume-section">
          <h2>Experience</h2>
          <div class="print-entry-heading">
            <div>
              <h3>{resumeExperience.role}</h3>
              <p>{resumeExperience.organization}</p>
            </div>
            <p>{resumeExperience.period}</p>
          </div>
          <ul class="print-bullet-list">
            {resumeExperience.details.map((detail) => <li>{detail}</li>)}
          </ul>
          <p class="print-confidentiality">{resumeExperience.confidentiality}</p>
        </section>
      </section>

      <section class="print-page print-page-two">
        <section class="print-resume-section">
          <h2>Projects</h2>
          <div class="print-project-grid">
            {
              resumeProjects.map((project) => (
                <article class="print-project">
                  <div class="print-entry-heading">
                    <div>
                      <h3>{project.title}</h3>
                      <p>{project.subtitle}</p>
                    </div>
                    <p>{project.technologies.join(" / ")}</p>
                  </div>
                  <ul class="print-bullet-list">
                    {project.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section class="print-resume-section">
          <h2>Education</h2>
          <div class="print-entry-heading">
            <div>
              <h3>{resumeEducation.institution}</h3>
              <p>{resumeEducation.qualification}</p>
            </div>
            <p>{resumeEducation.period}</p>
          </div>
          <p class="print-education-highlight">
            CGPA: {resumeEducation.cgpa} | {resumeEducation.distinction}
          </p>
          <p>
            <strong>Relevant coursework:</strong>{" "}
            {resumeEducation.coursework.join(", ")}
          </p>
          <p>
            <strong>Certifications:</strong>{" "}
            {resumeEducation.certifications.join("; ")}
          </p>
        </section>

        <section class="print-resume-section">
          <h2>Extracurricular Leadership</h2>
          <div class="print-leadership-grid">
            {
              resumeLeadership.map((item) => (
                <article class="print-leadership-entry">
                  <div class="print-entry-heading">
                    <div>
                      <h3>{item.role}</h3>
                      <p>{item.organization}</p>
                    </div>
                    <p>{item.period}</p>
                  </div>
                  <ul class="print-bullet-list">
                    {item.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <p class="print-resume-footer">
          {site.availability.detail}
        </p>
      </section>
    </article>

    <section class="resume-web-section resume-hero border-b-[3px] border-ink bg-blue py-14 text-white sm:py-20">
      <div class="page-shell grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="min-w-0 lg:col-span-8">
          <p class="section-kicker bg-yellow text-ink">Interactive resume / Candidate brief</p>
          <h1
            class="mt-3 max-w-5xl font-display text-[clamp(3.1rem,10vw,7.2rem)] font-black uppercase leading-[0.82] tracking-[-0.07em]"
          >
            Wan Muhammad Adam
          </h1>

          <ul class="mt-8 flex flex-wrap gap-2" aria-label="Target roles">
            {
              resumeProfile.roles.map((role, index) => (
                <li
                  class:list={[
                    "border-2 border-ink px-3 py-2 font-mono text-xs font-bold uppercase",
                    index === 0 ? "bg-yellow text-ink" : "bg-white text-ink",
                  ]}
                >
                  {role}
                </li>
              ))
            }
          </ul>

          <p class="mt-7 max-w-4xl text-lg font-semibold leading-relaxed sm:text-xl">
            {resumeProfile.summary}
          </p>

          <address class="mt-8 flex flex-wrap gap-x-6 gap-y-3 not-italic">
            <a class="resume-contact-link" href={`mailto:${site.email}`}>{site.email}</a>
            <a class="resume-contact-link" href={resumeProfile.phoneHref}>{resumeProfile.phone}</a>
            <a
              class="resume-contact-link"
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a
              class="resume-contact-link"
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </address>
        </div>

        <aside class="grid grid-cols-2 gap-4 text-ink lg:col-span-4" aria-label="Profile highlights">
          <div class="brutal-card bg-yellow p-5 sm:p-6">
            <p class="font-display text-4xl font-black leading-none sm:text-5xl">
              {resumeExperience.contributionCount}
            </p>
            <p class="mt-2 font-mono text-[0.68rem] font-bold uppercase leading-snug">
              Private enterprise contributions
            </p>
          </div>
          <div class="brutal-card bg-white p-5 sm:p-6">
            <p class="font-display text-4xl font-black leading-none sm:text-5xl">3.75</p>
            <p class="mt-2 font-mono text-[0.68rem] font-bold uppercase leading-snug">CGPA / 4.00</p>
          </div>
          <div class="brutal-card bg-coral p-5 sm:p-6">
            <p class="font-display text-4xl font-black leading-none sm:text-5xl">3</p>
            <p class="mt-2 font-mono text-[0.68rem] font-bold uppercase leading-snug">
              Enterprise systems integrated
            </p>
          </div>
          <div class="brutal-card bg-white p-5 sm:p-6">
            <p class="font-display text-4xl font-black leading-none sm:text-5xl">8</p>
            <p class="mt-2 font-mono text-[0.68rem] font-bold uppercase leading-snug">
              Members led
            </p>
          </div>
          <div class="col-span-2 border-[3px] border-ink bg-ink p-4 text-white">
            <p class="font-mono text-xs font-bold uppercase text-yellow">Availability</p>
            <p class="mt-1 font-display text-lg font-black">{site.availability.label}</p>
          </div>
        </aside>
      </div>
    </section>

    <section
      id="focus"
      class="resume-web-section resume-screen-only border-b-[3px] border-ink bg-paper py-16 sm:py-20"
      aria-labelledby="focus-heading"
      data-no-print
    >
      <div class="page-shell">
        <div class="grid gap-8 xl:grid-cols-[1.1fr_0.9fr] xl:items-end">
          <div>
            <p class="section-kicker bg-coral">Recruiter controls / Start here</p>
            <h2
              id="focus-heading"
              class="max-w-4xl font-display text-[clamp(2.5rem,8vw,5rem)] font-black uppercase leading-[0.9]"
            >
              What are you hiring for?
            </h2>
          </div>
          <p class="max-w-2xl text-lg font-semibold leading-relaxed xl:justify-self-end">
            Choose a lens to emphasize matching evidence. Nothing is removed, so the complete career story stays available.
          </p>
        </div>

        <div class="mt-10 grid gap-7 xl:grid-cols-[1fr_22rem]">
          <div
            class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5"
            role="group"
            aria-label="Resume focus"
          >
            {
              resumeFocusOptions.map((option, index) => (
                <button
                  class="resume-focus-button"
                  type="button"
                  data-focus-button
                  data-focus={option.id}
                  data-label={option.label}
                  data-summary={option.summary}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <span class="block font-mono text-[0.65rem] font-bold uppercase tracking-wider">
                    {String(index + 1).padStart(2, "0")} / {option.label}
                  </span>
                  <span class="mt-2 block font-display text-lg font-black leading-tight">
                    {option.prompt}
                  </span>
                </button>
              ))
            }
          </div>

          <aside class="border-[3px] border-ink bg-blue p-5 text-white shadow-[5px_5px_0_#111]">
            <p class="font-mono text-xs font-bold uppercase text-yellow">Active lens</p>
            <h3 class="mt-1 font-display text-2xl font-black" data-active-focus-label>
              Full profile
            </h3>
            <p class="mt-3 text-sm font-semibold leading-relaxed" data-active-focus-summary>
              {resumeFocusOptions[0].summary}
            </p>
            <p class="mt-4 border-t-2 border-white pt-3 font-mono text-xs font-bold" data-evidence-count>
              {totalEvidence} evidence cards in this profile
            </p>
          </aside>
        </div>

        <div class="mt-8 flex flex-col gap-4 border-t-[3px] border-ink pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-2xl font-medium">
            Prefer a faster read? Change every evidence card at once, or open individual details as needed.
          </p>
          <div class="flex shrink-0 gap-2" role="group" aria-label="Resume detail level">
            <button
              class="resume-density-button"
              type="button"
              data-density-button="scan"
              aria-pressed="true"
            >
              Quick scan
            </button>
            <button
              class="resume-density-button"
              type="button"
              data-density-button="detail"
              aria-pressed="false"
            >
              Deep dive
            </button>
          </div>
        </div>

        <noscript>
          <p class="mt-6 border-[3px] border-ink bg-yellow p-4 font-bold">
            Interactive filters require JavaScript. The complete resume remains available below.
          </p>
        </noscript>
        <p class="sr-only" aria-live="polite" data-resume-status></p>
      </div>
    </section>

    <section id="capabilities" class="resume-web-section border-b-[3px] border-ink bg-yellow py-16 sm:py-20">
      <div class="page-shell">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="section-kicker bg-white">Capability index / Selectable proof</p>
            <h2
              class="font-display text-[clamp(2.5rem,9vw,5rem)] font-black uppercase leading-[0.9]"
            >
              Skills connected to work.
            </h2>
          </div>
          <p class="max-w-xl text-lg font-semibold leading-relaxed lg:col-span-4">
            Select any underlined skill to highlight the experience, project, or education entry that demonstrates it.
          </p>
        </div>

        <div class="resume-skills-grid mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {
            resumeSkillGroups.map((group) => (
              <article class="resume-skill-group brutal-card overflow-hidden bg-white">
                <header
                  class:list={[
                    "border-b-[3px] border-ink p-5",
                    skillAccentClasses[group.accent],
                  ]}
                >
                  <h3 class="font-display text-xl font-black uppercase">{group.title}</h3>
                </header>
                <ul class="flex flex-wrap gap-2 p-5">
                  {group.skills.map((item) => (
                    <li
                      data-skill-tags={item.tags.join(" ")}
                      class="resume-skill-item"
                    >
                      {item.evidence.length > 0 ? (
                        <button
                          class="resume-skill resume-skill--action"
                          type="button"
                          data-skill-button
                          data-skill-name={item.name}
                          data-skill-key={slugify(item.name)}
                          data-evidence-targets={item.evidence.join(" ")}
                          aria-pressed="false"
                        >
                          {item.name}
                          <span aria-hidden="true"> -&gt;</span>
                          <span class="sr-only"> Show supporting evidence</span>
                        </button>
                      ) : (
                        <span class="resume-skill">{item.name}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="experience" class="resume-web-section border-b-[3px] border-ink bg-paper py-16 sm:py-20">
      <div class="page-shell">
        <div class="mb-10 grid gap-5 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="section-kicker bg-coral">Experience / Enterprise delivery</p>
            <h2
              class="font-display text-[clamp(2.5rem,9vw,5rem)] font-black uppercase leading-[0.9]"
            >
              Work that crossed systems.
            </h2>
          </div>
          <p class="max-w-xl text-lg font-semibold leading-relaxed lg:col-span-4">
            Product features, backend integration, grounded AI workflows, and peer-reviewed delivery in one placement.
          </p>
        </div>

        <article
          id={`evidence-${resumeExperience.id}`}
          class="resume-evidence-card brutal-card scroll-mt-24 overflow-hidden bg-white"
          data-evidence-card
          data-evidence-id={resumeExperience.id}
          data-evidence-label={`${resumeExperience.role} at ${resumeExperience.organization}`}
          data-focus-tags={resumeExperience.tags.join(" ")}
        >
          <header class="grid gap-5 border-b-[3px] border-ink bg-blue p-6 text-white sm:p-8 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
              <p class="font-mono text-xs font-bold uppercase tracking-wider text-yellow">Industry experience</p>
              <h3 class="mt-2 font-display text-3xl font-black uppercase sm:text-5xl">
                {resumeExperience.role}
              </h3>
              <p class="mt-2 text-xl font-extrabold">{resumeExperience.organization}</p>
            </div>
            <p class="w-fit border-2 border-white bg-ink px-3 py-2 font-mono text-xs font-bold uppercase">
              {resumeExperience.period}
            </p>
          </header>

          <div class="p-6 sm:p-8">
            <div class="grid gap-7 lg:grid-cols-[1fr_15rem] lg:items-start">
              <div>
                <p class="max-w-4xl text-xl font-bold leading-relaxed">
                  {resumeExperience.summary}
                </p>
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="B. Braun technologies">
                  {
                    resumeExperience.technologies.map((technology) => (
                      <li class="brutal-chip bg-paper">{technology}</li>
                    ))
                  }
                </ul>
              </div>

              <aside class="border-[3px] border-ink bg-yellow p-5 text-center">
                <p class="font-display text-5xl font-black leading-none">
                  {resumeExperience.contributionCount}
                </p>
                <p class="mt-2 font-mono text-xs font-bold uppercase leading-snug">
                  contributions across private enterprise repositories
                </p>
              </aside>
            </div>

            <details class="resume-details mt-7 border-[3px] border-ink" data-resume-details>
              <summary class="resume-details-summary">
                <span>Contribution details</span>
                <span class="resume-details-state" aria-hidden="true"></span>
              </summary>
              <ul class="space-y-3 border-t-[3px] border-ink bg-paper p-5 sm:p-6">
                {
                  resumeExperience.details.map((detail) => (
                    <li class="grid grid-cols-[1rem_1fr] gap-3 font-medium leading-relaxed">
                      <span class="font-mono font-black text-blue" aria-hidden="true">#</span>
                      <span>{detail}</span>
                    </li>
                  ))
                }
              </ul>
            </details>

            <p class="mt-5 border-l-[3px] border-ink bg-paper-deep px-4 py-3 text-sm font-semibold leading-relaxed">
              <span class="font-mono text-xs font-bold uppercase">Confidentiality note:</span>{" "}
              {resumeExperience.confidentiality}
            </p>

            <div class="resume-system-map mt-10 border-t-[3px] border-ink pt-8" data-system-map>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="font-mono text-xs font-bold uppercase tracking-wider text-blue">
                    Interactive system landscape
                  </p>
                  <h4 class="mt-1 font-display text-2xl font-black uppercase sm:text-3xl">
                    Select a layer to inspect the contribution.
                  </h4>
                </div>
                <p class="max-w-md text-sm font-semibold leading-relaxed">
                  A generalized view of the delivery surface, without private project identifiers.
                </p>
              </div>

              <div class="system-node-grid mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
                {
                  systemLayers.map((layer, index) => (
                    <button
                      class="system-node"
                      type="button"
                      data-system-node
                      data-label={layer.label}
                      data-description={layer.contribution}
                      aria-controls="system-contribution"
                      aria-pressed={index === 0 ? "true" : "false"}
                    >
                      <span class="font-mono text-[0.65rem] font-bold uppercase tracking-wider">
                        Layer {String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="mt-2 block font-display text-lg font-black">{layer.label}</span>
                      <span class="mt-2 block text-xs font-semibold leading-snug">
                        {layer.technology}
                      </span>
                    </button>
                  ))
                }
              </div>

              <div id="system-contribution" class="mt-4 border-[3px] border-ink bg-coral p-5" aria-live="polite">
                <p class="font-mono text-xs font-bold uppercase">Contribution at this layer</p>
                <p class="mt-1 font-display text-xl font-black" data-system-label>
                  {systemLayers[0].label}
                </p>
                <p class="mt-2 max-w-4xl font-semibold leading-relaxed" data-system-description>
                  {systemLayers[0].contribution}
                </p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="projects" class="resume-web-section border-b-[3px] border-ink bg-blue py-16 text-white sm:py-20">
      <div class="page-shell">
        <div class="mb-10 grid gap-5 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="section-kicker bg-yellow text-ink">Projects / End-to-end proof</p>
            <h2
              class="font-display text-[clamp(2.5rem,9vw,5rem)] font-black uppercase leading-[0.9]"
            >
              Products shipped across stacks.
            </h2>
          </div>
          <p class="max-w-xl text-lg font-semibold leading-relaxed lg:col-span-4">
            Web, API, database, state-management, and cross-platform decisions carried through complete products.
          </p>
        </div>

        <div class="grid gap-7 lg:grid-cols-2">
          {
            resumeProjects.map((project, index) => (
              <article
                id={`evidence-${project.id}`}
                class="resume-evidence-card brutal-card scroll-mt-24 overflow-hidden bg-white text-ink"
                data-evidence-card
                data-evidence-id={project.id}
                data-evidence-label={project.title}
                data-focus-tags={project.tags.join(" ")}
              >
                <header
                  class:list={[
                    "border-b-[3px] border-ink p-6",
                    index % 2 === 0 ? "bg-yellow" : "bg-coral",
                  ]}
                >
                  <p class="font-mono text-xs font-bold uppercase tracking-wider">
                    Project {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3 class="mt-2 font-display text-4xl font-black uppercase">{project.title}</h3>
                  <p class="mt-2 font-bold leading-snug">{project.subtitle}</p>
                </header>

                <div class="p-6">
                  <p class="text-lg font-semibold leading-relaxed">{project.summary}</p>
                  <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${project.title} technologies`}>
                    {project.technologies.map((technology) => <li class="brutal-chip">{technology}</li>)}
                  </ul>

                  <details class="resume-details mt-6 border-[3px] border-ink" data-resume-details>
                    <summary class="resume-details-summary">
                      <span>Delivery details</span>
                      <span class="resume-details-state" aria-hidden="true"></span>
                    </summary>
                    <ul class="space-y-3 border-t-[3px] border-ink bg-paper p-5">
                      {project.details.map((detail) => (
                        <li class="grid grid-cols-[1rem_1fr] gap-3 font-medium leading-relaxed">
                          <span class="font-mono font-black text-blue" aria-hidden="true">#</span>
                          <span>{detail}</span>
                        </li>
                      ))}
                    </ul>
                  </details>

                  <a
                    class="brutal-button brutal-button--yellow mt-6"
