        <a class="text-link text-white hover:text-yellow" href={homeUrl}>Portfolio</a>
        <a class="text-link text-white hover:text-yellow" href={site.linkedin}>LinkedIn</a>
        <a class="text-link text-white hover:text-yellow" href={site.github}>GitHub</a>
      </div>
      <p class="resume-print-only hidden font-mono text-xs">{site.email} / {resumeProfile.phone}</p>
    </div>
  </footer>

  <script>
    type Focus = "all" | "ai" | "backend" | "fullstack" | "leadership";
    type Density = "scan" | "detail";

    const app = document.querySelector<HTMLElement>("[data-resume-app]");

    if (app) {
      const focusButtons = Array.from(
        app.querySelectorAll<HTMLButtonElement>("[data-focus-button]"),
      );
      const densityButtons = Array.from(
        app.querySelectorAll<HTMLButtonElement>("[data-density-button]"),
      );
      const skillButtons = Array.from(
        app.querySelectorAll<HTMLButtonElement>("[data-skill-button]"),
      );
      const skillItems = Array.from(
        app.querySelectorAll<HTMLElement>("[data-skill-tags]"),
      );
      const evidenceCards = Array.from(
        app.querySelectorAll<HTMLElement>("[data-evidence-card]"),
      );
      const detailSections = Array.from(
        app.querySelectorAll<HTMLDetailsElement>("[data-resume-details]"),
      );
      const activeLabel = app.querySelector<HTMLElement>("[data-active-focus-label]");
      const activeSummary = app.querySelector<HTMLElement>("[data-active-focus-summary]");
      const evidenceCount = app.querySelector<HTMLElement>("[data-evidence-count]");
      const status = app.querySelector<HTMLElement>("[data-resume-status]");
      const validFocuses: Focus[] = ["all", "ai", "backend", "fullstack", "leadership"];
      let isPrintTransition = false;
      let printDetailState: boolean[] = [];

      const updateUrl = (updates: Record<string, string | null>) => {
        const url = new URL(window.location.href);

        Object.entries(updates).forEach(([key, value]) => {
          if (value) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        });

        window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
      };

      const clearEvidenceState = () => {
        evidenceCards.forEach((card) => {
          card.classList.remove("is-evidence-muted", "is-evidence-emphasized");
        });
      };

      const clearSkillState = () => {
        skillButtons.forEach((button) => {
          button.setAttribute("aria-pressed", "false");
        });
      };

      const setFocus = (
        focus: Focus,
        { writeUrl = true, announce = true } = {},
      ) => {
        const selectedButton = focusButtons.find(
          (button) => button.dataset.focus === focus,
        );
        if (!selectedButton) return;

        clearEvidenceState();
        clearSkillState();

        focusButtons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.focus === focus),
          );
        });

        const matchingCards = evidenceCards.filter((card) => {
          const tags = card.dataset.focusTags?.split(" ") ?? [];
          return focus === "all" || tags.includes(focus);
        });

        evidenceCards.forEach((card) => {
          if (focus === "all") return;
          const matches = matchingCards.includes(card);
          card.classList.toggle("is-evidence-emphasized", matches);
          card.classList.toggle("is-evidence-muted", !matches);
        });

        skillItems.forEach((item) => {
          const tags = item.dataset.skillTags?.split(" ") ?? [];
          item.classList.toggle(
            "is-skill-muted",
            focus !== "all" && !tags.includes(focus),
          );
        });

        if (activeLabel) activeLabel.textContent = selectedButton.dataset.label ?? "Full profile";
        if (activeSummary) activeSummary.textContent = selectedButton.dataset.summary ?? "";
        if (evidenceCount) {
          evidenceCount.textContent =
            focus === "all"
              ? `${evidenceCards.length} evidence cards in this profile`
              : `${matchingCards.length} of ${evidenceCards.length} evidence cards emphasized`;
        }
        if (announce && status) {
          status.textContent = `${selectedButton.dataset.label} lens selected. ${matchingCards.length} evidence cards emphasized.`;
        }
        if (writeUrl) {
          updateUrl({
            focus: focus === "all" ? null : focus,
            skill: null,
          });
        }
      };

      const setSkill = (
        selectedButton: HTMLButtonElement,
        { writeUrl = true, announce = true } = {},
      ) => {
        const isAlreadySelected = selectedButton.getAttribute("aria-pressed") === "true";
        if (isAlreadySelected) {
          setFocus("all", { writeUrl, announce });
          return;
        }

        clearEvidenceState();
        clearSkillState();
        skillItems.forEach((item) => item.classList.remove("is-skill-muted"));
        focusButtons.forEach((button) => button.setAttribute("aria-pressed", "false"));
        selectedButton.setAttribute("aria-pressed", "true");

        const targets = selectedButton.dataset.evidenceTargets?.split(" ") ?? [];
        const matchingCards = evidenceCards.filter((card) =>
          targets.includes(card.dataset.evidenceId ?? ""),
        );
        const evidenceNames = matchingCards
          .map((card) => card.dataset.evidenceLabel)
          .filter(Boolean);

        evidenceCards.forEach((card) => {
          const matches = matchingCards.includes(card);
          card.classList.toggle("is-evidence-emphasized", matches);
          card.classList.toggle("is-evidence-muted", !matches);
        });

        const skillName = selectedButton.dataset.skillName ?? "Selected skill";
        if (activeLabel) activeLabel.textContent = `Skill proof: ${skillName}`;
        if (activeSummary) {
          activeSummary.textContent = `Highlighted where ${skillName} is demonstrated: ${evidenceNames.join(", ")}.`;
        }
        if (evidenceCount) {
          evidenceCount.textContent = `${matchingCards.length} supporting evidence ${matchingCards.length === 1 ? "card" : "cards"}`;
        }
        if (announce && status) {
          status.textContent = `${skillName} selected. Supporting evidence: ${evidenceNames.join(", ")}.`;
        }
        if (writeUrl) {
          updateUrl({
            focus: null,
            skill: selectedButton.dataset.skillKey ?? null,
          });
        }
      };

      const setDensity = (
        density: Density,
        { writeUrl = true } = {},
      ) => {
        densityButtons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.densityButton === density),
          );
        });
        detailSections.forEach((details) => {
          details.open = density === "detail";
        });
        if (status) {
          status.textContent =
            density === "detail"
              ? "All contribution details expanded."
              : "All contribution details collapsed.";
        }
        if (writeUrl) {
          updateUrl({ view: density === "detail" ? "detail" : null });
        }
      };

      const syncDensityFromDetails = () => {
        if (isPrintTransition) return;

        const openCount = detailSections.filter((details) => details.open).length;
        const density = openCount === detailSections.length
          ? "detail"
          : openCount === 0
            ? "scan"
            : null;

        densityButtons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.densityButton === density),
          );
        });
        updateUrl({ view: density === "detail" ? "detail" : null });
      };

      focusButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const focus = button.dataset.focus as Focus;
          if (validFocuses.includes(focus)) setFocus(focus);
        });
      });

      skillButtons.forEach((button) => {
        button.addEventListener("click", () => setSkill(button));
      });

      densityButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const density = button.dataset.densityButton as Density;
          if (density === "scan" || density === "detail") setDensity(density);
        });
      });

      detailSections.forEach((details) => {
        details.addEventListener("toggle", syncDensityFromDetails);
      });

      window.addEventListener("beforeprint", () => {
        isPrintTransition = true;
        printDetailState = detailSections.map((details) => details.open);
        detailSections.forEach((details) => {
          details.open = true;
        });
      });

      window.addEventListener("afterprint", () => {
        detailSections.forEach((details, index) => {
          details.open = printDetailState[index] ?? false;
        });
        window.setTimeout(() => {
          isPrintTransition = false;
          syncDensityFromDetails();
        }, 0);
      });

      const params = new URLSearchParams(window.location.search);
      const initialSkill = params.get("skill");
      const initialSkillButton = initialSkill
        ? skillButtons.find((button) => button.dataset.skillKey === initialSkill)
        : undefined;
      const requestedFocus = params.get("focus") as Focus | null;
      const initialFocus = requestedFocus && validFocuses.includes(requestedFocus)
        ? requestedFocus
        : "all";

      if (initialSkillButton) {
        setSkill(initialSkillButton, { writeUrl: false, announce: false });
      } else {
        setFocus(initialFocus, { writeUrl: false, announce: false });
      }
      setDensity(params.get("view") === "detail" ? "detail" : "scan", {
        writeUrl: false,
      });
    }

    document.querySelectorAll<HTMLElement>("[data-system-map]").forEach((map) => {
      const nodes = Array.from(
        map.querySelectorAll<HTMLButtonElement>("[data-system-node]"),
      );
      const label = map.querySelector<HTMLElement>("[data-system-label]");
      const description = map.querySelector<HTMLElement>("[data-system-description]");

      nodes.forEach((node) => {
        node.addEventListener("click", () => {
          nodes.forEach((item) => {
            item.setAttribute("aria-pressed", String(item === node));
          });
          if (label) label.textContent = node.dataset.label ?? "Selected layer";
          if (description) description.textContent = node.dataset.description ?? "";
        });
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-print-button]").forEach((button) => {
      button.addEventListener("click", () => window.print());
    });
  </script>

  <style>
    .resume-contact-link {
      color: white;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration-line: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .resume-contact-link:hover {
      color: var(--color-yellow);
      text-decoration-thickness: 4px;
    }

    .resume-focus-button {
      min-height: 7rem;
      border: 3px solid var(--color-ink);
      padding: 1rem;
      background: var(--color-white);
      color: var(--color-ink);
      text-align: left;
      box-shadow: 4px 4px 0 var(--color-ink);
      transition:
        translate 140ms ease,
        box-shadow 140ms ease,
        background-color 140ms ease;
    }

    .resume-focus-button:hover {
      translate: 2px 2px;
      box-shadow: 2px 2px 0 var(--color-ink);
    }

    .resume-focus-button[aria-pressed="true"] {
      translate: 4px 4px;
      background: var(--color-yellow);
      box-shadow: none;
    }

    .resume-density-button {
      min-height: 2.75rem;
      border: 3px solid var(--color-ink);
      padding: 0.55rem 0.9rem;
      background: var(--color-white);
      color: var(--color-ink);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .resume-density-button[aria-pressed="true"] {
      background: var(--color-ink);
      color: var(--color-white);
    }

    .resume-skill-item {
      transition: opacity 180ms ease;
    }

    .resume-skill-item.is-skill-muted {
      filter: grayscale(1);
    }

    .resume-skill-item.is-skill-muted .resume-skill {
      border-style: dashed;
      background: var(--color-paper-deep);
      color: #444;
    }

    .resume-skill {
      display: inline-flex;
      min-height: 2.1rem;
      align-items: center;
      border: 2px solid var(--color-ink);
      padding: 0.35rem 0.65rem;
      background: var(--color-paper);
      color: var(--color-ink);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      line-height: 1.25;
      text-align: left;
    }

    .resume-skill--action {
      cursor: pointer;
      text-decoration-line: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }

    .resume-skill--action:hover,
    .resume-skill--action[aria-pressed="true"] {
      background: var(--color-yellow);
      text-decoration-thickness: 3px;
    }

    .resume-skill--action[aria-pressed="true"] {
      box-shadow: 3px 3px 0 var(--color-ink);
    }

    .resume-evidence-card {
      transition:
        opacity 180ms ease,
        filter 180ms ease,
        outline-color 180ms ease,
        translate 180ms ease;
    }

    .resume-evidence-card.is-evidence-muted {
      filter: grayscale(1);
      box-shadow: 2px 2px 0 var(--color-ink);
    }

    .resume-evidence-card.is-evidence-emphasized {
      outline: 6px solid var(--color-yellow);
      outline-offset: 5px;
      translate: 0 -3px;
    }

    .resume-details-summary {
      display: flex;
      min-height: 3.25rem;
      cursor: pointer;
      list-style: none;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.8rem 1rem;
      background: var(--color-white);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .resume-details-summary::-webkit-details-marker {
      display: none;
    }

    .resume-details-summary:hover {
      background: var(--color-yellow);
    }

    .resume-details-state::before {
      content: "+";
      display: inline-flex;
      width: 1.75rem;
      height: 1.75rem;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--color-ink);
      background: var(--color-yellow);
      color: var(--color-ink);
      font-size: 1.1rem;
      line-height: 1;
    }

    details[open] .resume-details-state::before {
      content: "-";
    }

    .system-node {
      min-height: 9.5rem;
      border: 3px solid var(--color-ink);
      padding: 1rem;
      background: var(--color-paper);
      color: var(--color-ink);
      text-align: left;
      box-shadow: 3px 3px 0 var(--color-ink);
      transition:
        translate 140ms ease,
        box-shadow 140ms ease,
        background-color 140ms ease;
    }

    .system-node:hover {
      translate: 1px 1px;
      box-shadow: 2px 2px 0 var(--color-ink);
    }

    .system-node[aria-pressed="true"] {
      translate: 3px 3px;
      background: var(--color-yellow);
      box-shadow: none;
    }

    @media (max-width: 639px) {
      .resume-evidence-card.is-evidence-emphasized {
        outline-width: 4px;
        outline-offset: 3px;
      }
    }

    @media print {
      @page {
        size: A4;
        margin: 10mm;
      }

      :global(html) {
        font-size: 9pt;
      }

      :global(body) {
        background: white !important;
        color: black !important;
      }

      :global(.page-shell) {
        width: 100% !important;
        max-width: none !important;
      }

      :global(a[href="#main-content"]),
      [data-no-print],
      .resume-screen-only,
      .resume-system-map {
        display: none !important;
      }

      .resume-print-only {
        display: block !important;
      }

      .resume-web-section,
      .resume-footer {
        display: none !important;
      }

      .resume-document {
        color: #111;
        font-family: Arial, sans-serif;
        font-size: 8.5pt;
        line-height: 1.32;
      }

      .print-page-two {
        break-before: page;
      }

      .print-resume-header {
        border-bottom: 2px solid #1d4ed8;
        padding-bottom: 3mm;
      }

      .print-resume-header h1 {
        margin: 0;
        font-size: 25pt;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1;
        text-transform: uppercase;
      }

      .print-role-line {
        margin: 1.5mm 0 0;
        color: #1d4ed8;
        font-size: 9pt;
        font-weight: 700;
      }

      .print-contact-line {
        display: flex;
        flex-wrap: wrap;
        gap: 1mm 4mm;
        margin: 2mm 0 0;
        font-size: 7.5pt;
        font-weight: 600;
      }

      .print-resume-section {
        margin-top: 3.5mm;
      }

      .print-resume-section > h2 {
        margin: 0 0 2mm;
        border-bottom: 1px solid #111;
        padding-bottom: 0.8mm;
        color: #1d4ed8;
        font-size: 11pt;
        font-weight: 800;
        letter-spacing: 0.04em;
        line-height: 1;
        text-transform: uppercase;
      }

      .print-resume-section p,
      .print-entry-heading h3 {
        margin: 0;
      }

      .print-skill-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.2mm 5mm;
      }

      .print-skill-row {
        break-inside: avoid;
      }

      .print-skill-row h3 {
        display: inline;
        font-size: 8pt;
        font-weight: 800;
        text-transform: uppercase;
      }

      .print-skill-row h3::after {
        content: ": ";
      }

