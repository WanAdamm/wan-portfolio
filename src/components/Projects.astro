---
import Reveal from "./Reveal.astro";
import { projects, type ProjectSize } from "../data/projects";
import { assetPath } from "../data/site";

const columnClasses: Record<ProjectSize, string> = {
  large: "flex flex-col md:col-span-7",
  medium: "flex flex-col md:col-span-5",
  wide: "md:col-span-12 md:grid md:grid-cols-[1.3fr_1fr]",
};

const mediaClasses: Record<ProjectSize, string> = {
  large: "h-64 sm:h-80",
  medium: "h-64 sm:h-80",
  wide: "h-64 sm:h-80 md:h-full md:min-h-[360px] md:border-b-0 md:border-r-[3px]",
};

const imageSizes: Record<ProjectSize, string> = {
  large:
    "(min-width: 1200px) 620px, (min-width: 768px) 58vw, calc(100vw - 2.5rem)",
  medium:
    "(min-width: 1200px) 450px, (min-width: 768px) 42vw, calc(100vw - 2.5rem)",
  wide:
    "(min-width: 1200px) 650px, (min-width: 768px) 55vw, calc(100vw - 2.5rem)",
};
---

<Reveal id="projects" class="border-y-[3px] border-ink bg-yellow py-20 sm:py-24">
  <div class="page-shell">
    <div class="mb-12 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="section-kicker bg-white">Selected work / 02</p>
        <h2 class="font-display text-[clamp(2.5rem,11.5vw,4.5rem)] font-black uppercase leading-none">
          Built, not imagined.
        </h2>
      </div>
      <p class="max-w-md border-l-[3px] border-ink pl-5 text-lg font-semibold leading-relaxed">
        Complete products spanning web, backend, database, mobile, and deployment decisions.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      {
        projects.map((project, index) => {
          const imageStem = project.image.replace(/\.[^.]+$/, "");
          const optimizedSources = [640, 1200]
            .map(
              (width) =>
                `${assetPath(`${imageStem}-${width}.webp`)} ${width}w`,
            )
            .join(", ");

          return (
            <article
              class={`brutal-card group overflow-hidden ${columnClasses[project.size]}`}
            >
              <div
                class={`overflow-hidden border-b-[3px] border-ink bg-paper-deep ${mediaClasses[project.size]}`}
              >
                <picture class="block h-full">
                  <source
                    type="image/webp"
                    srcset={optimizedSources}
                    sizes={imageSizes[project.size]}
                  />
                  <img
                    src={assetPath(project.image)}
                    alt={project.imageAlt}
                    width={project.imageWidth}
                    height={project.imageHeight}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-top transition-transform duration-200 group-hover:scale-[1.015]"
                  />
                </picture>
              </div>

              <div class="flex flex-1 flex-col bg-white p-6 sm:p-8">
                <div class="mb-5 flex items-center justify-between gap-4">
                  <span class="brutal-chip bg-coral">Project {String(index + 1).padStart(2, "0")}</span>
                  <span class="font-mono text-xs font-bold uppercase">Case study</span>
                </div>

                <h3 class="font-display text-3xl font-black uppercase sm:text-4xl">
                  {project.title}
                </h3>
                <p class="mt-4 flex-1 font-medium leading-relaxed">{project.description}</p>

                <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${project.title} technologies`}>
                  {project.stack.map((item) => <li class="brutal-chip">{item}</li>)}
                </ul>

                <div class="mt-7 flex flex-wrap gap-4">
                  {project.github && (
                    <a
                      class="brutal-button brutal-button--yellow"
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      GitHub <span aria-hidden="true">-&gt;</span>
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  )}
                  {project.live && (
                    <a
                      class="brutal-button brutal-button--blue"
                      href={project.live}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Live site <span aria-hidden="true">-&gt;</span>
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</Reveal>
