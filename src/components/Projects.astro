---
import Reveal from "./Reveal.astro";
import { projects, type ProjectSize } from "../data/projects";
import { assetPath } from "../data/site";

const columnClasses: Record<ProjectSize, string> = {
  large: "md:col-span-7",
  medium: "md:col-span-5",
  wide: "md:col-span-12",
};

const imageSizes: Record<ProjectSize, string> = {
  large:
    "(min-width: 1200px) 620px, (min-width: 768px) 58vw, calc(100vw - 2.5rem)",
  medium:
    "(min-width: 1200px) 450px, (min-width: 768px) 42vw, calc(100vw - 2.5rem)",
  wide:
    "(min-width: 1200px) 1070px, (min-width: 768px) calc(100vw - 8rem), calc(100vw - 2.5rem)",
};
---

<Reveal id="projects" class="mx-auto max-w-[1200px] px-5 py-12 md:px-16">
  <h2 class="mb-12 font-display text-4xl font-semibold tracking-[-0.02em]">
    Selected Projects
  </h2>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:auto-rows-[380px]">
    {
      projects.map((project) => {
        const imageStem = project.image.replace(/\.[^.]+$/, "");
        const optimizedSources = [640, 1200]
          .map(
            (width) =>
              `${assetPath(`${imageStem}-${width}.webp`)} ${width}w`,
          )
          .join(", ");

        return (
          <article
            class={`glass group relative h-[320px] overflow-hidden rounded-2xl transition duration-500 hover:scale-[1.02] md:h-auto ${columnClasses[project.size]}`}
          >
            <div class="absolute inset-0 z-10 bg-gradient-to-t from-background via-background/60 to-transparent" />

            <picture>
              <source
                type="image/webp"
                srcset={optimizedSources}
                sizes={imageSizes[project.size]}
              />
              <img
                src={assetPath(project.image)}
                alt={`${project.title} preview`}
                width={project.imageWidth}
                height={project.imageHeight}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-70 transition duration-1000 group-hover:scale-110"
              />
            </picture>

            <div class="absolute bottom-0 left-0 z-20 w-full p-4 md:p-8">
              <div class="mb-2 flex flex-wrap gap-1.5 md:mb-4 md:gap-2">
                {project.stack.map((item) => (
                  <span class="tech-chip rounded-full px-2.5 py-0.5 text-xs md:px-3 md:py-1">
                    {item}
                  </span>
                ))}
              </div>

              <h3 class="mb-1 font-display text-xl font-semibold text-on-surface md:mb-2 md:text-3xl">
                {project.title}
              </h3>

              <p class="mb-3 max-w-xl line-clamp-2 text-sm text-on-surface-variant text-justify md:mb-6 md:line-clamp-none md:text-base">
                {project.description}
              </p>

              <div class="flex gap-4">
                {project.github && (
                  <a
                    class="inline-flex items-center gap-2 text-sm text-primary transition hover:gap-4 md:text-base"
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    GitHub
                    <span
                      class="material-symbols-outlined text-sm md:text-base"
                      aria-hidden="true"
                    >
                      north_east
                    </span>
                  </a>
                )}

                {project.live && (
                  <a
                    class="inline-flex items-center gap-2 text-sm text-primary transition hover:gap-4 md:text-base"
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Live Demo
                    <span
                      class="material-symbols-outlined text-sm md:text-base"
                      aria-hidden="true"
                    >
                      north_east
                    </span>
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</Reveal>
