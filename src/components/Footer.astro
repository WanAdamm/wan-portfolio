---
import { navigation, site } from "../data/site";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-outline-variant/40 bg-background">
  <div class="mx-auto max-w-[1200px] px-5 py-10 md:px-16">
    <div
      class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <p class="font-display text-xl font-bold text-on-surface">
          {site.name}
        </p>
        <p class="mt-2 max-w-md text-sm text-on-surface-variant">
          Early-career software engineer focused on data science, automation,
          and full-stack development. Open for full-time opportunities starting
          August 2027.
        </p>
      </div>

      <nav
        class="flex flex-wrap gap-5 font-mono text-sm text-on-surface-variant"
        aria-label="Footer navigation"
      >
        {
          navigation.map((link) => (
            <a href={link.href} class="transition hover:text-primary">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-4 border-t border-outline-variant/40 pt-6 md:flex-row md:items-center md:justify-between"
    >
      <p class="font-mono text-xs text-on-surface-variant">
        © {currentYear} {site.name}. Built with Astro and Tailwind CSS.
      </p>

      <div
        class="flex gap-4 font-mono text-xs text-on-surface-variant"
      >
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="transition hover:text-primary"
        >
          GitHub
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="transition hover:text-primary"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:${site.email}`}
          class="transition hover:text-primary"
        >
          Email
        </a>
      </div>
    </div>
  </div>
</footer>
