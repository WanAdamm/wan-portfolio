---
import { navigation, site } from "../data/site";

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div class="page-shell py-12">
    <div class="grid gap-10 md:grid-cols-2 md:items-end">
      <div>
        <p class="font-display text-3xl font-black uppercase text-yellow">{site.name}</p>
        <p class="mt-3 max-w-lg font-medium leading-relaxed">
          Final-year Computer Science student and early-career software engineer focused on AI,
          backend systems, automation, and full-stack delivery.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-4 md:justify-end" aria-label="Footer navigation">
        {
          navigation.map((link) => (
            <a
              href={link.href}
              class="min-h-11 py-3 font-mono text-xs font-bold uppercase text-white underline decoration-2 underline-offset-4 hover:text-yellow"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-5 border-t-[3px] border-white pt-7 md:flex-row md:items-center md:justify-between">
      <p class="font-mono text-xs font-bold uppercase">
        © {currentYear} {site.name} / Built with Astro
      </p>
      <div class="flex flex-wrap gap-5 font-mono text-xs font-bold uppercase">
        <a class="text-link text-white hover:text-yellow" href={site.github} target="_blank" rel="noopener noreferrer">
          GitHub<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a class="text-link text-white hover:text-yellow" href={site.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn<span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a class="text-link text-white hover:text-yellow" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </div>
</footer>
