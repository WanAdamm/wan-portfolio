---
import Reveal from "./Reveal.astro";
import { timeline } from "../data/timeline";

const labelColors = ["bg-yellow", "bg-coral", "bg-white"] as const;
---

<Reveal id="experience" class="border-b-[3px] border-ink bg-blue py-20 text-white sm:py-24">
  <div class="page-shell">
    <div class="mb-12 grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="min-w-0 lg:col-span-8">
        <p class="section-kicker bg-yellow text-ink">Experience / 03</p>
        <h2 class="font-display text-[clamp(2.5rem,11.5vw,4.5rem)] font-black uppercase leading-none">
          Learning by shipping.
        </h2>
      </div>
      <p class="min-w-0 max-w-xl text-lg font-semibold leading-relaxed lg:col-span-4">
        Enterprise engineering, full-stack projects, and a strong foundation in intelligent computing.
      </p>
    </div>

    <ol class="space-y-7">
      {
        timeline.map((item, index) => (
          <li>
            <article class="brutal-card grid overflow-hidden text-ink md:grid-cols-[15rem_1fr]">
              <div
                class:list={[
                  "border-b-[3px] border-ink p-6 md:border-b-0 md:border-r-[3px] md:p-8",
                  labelColors[index % labelColors.length],
                ]}
              >
                <p class="font-mono text-xs font-bold uppercase tracking-[0.12em]">
                  {item.category}
                </p>
                <p class="mt-3 font-display text-2xl font-black leading-tight">
                  <time datetime={item.start.datetime}>{item.start.label}</time>
                  <span aria-hidden="true"> - </span><span class="sr-only"> to </span>
                  <time datetime={item.end.datetime}>{item.end.label}</time>
                </p>
              </div>
              <div class="bg-white p-6 md:p-8">
                <h3 class="font-display text-2xl font-black sm:text-3xl">{item.title}</h3>
                <p class="mt-4 max-w-4xl font-medium leading-relaxed">{item.description}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</Reveal>
