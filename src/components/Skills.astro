---
import Reveal from "./Reveal.astro";
import InteractiveGlow from "./react/InteractiveGlow";
import {
  languageSkills,
  aiDataSkills,
  frontendSkills,
  devopsSkills,
} from "../data/skills";
---

<Reveal id="skills" class="bg-surface-container-lowest/50 py-12">
  <div class="mx-auto max-w-[1200px] px-5 md:px-16">
    <h2
      class="mb-12 text-center font-display text-4xl font-semibold tracking-[-0.02em]"
    >
      Engineering Dashboard
    </h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <!-- Category: Programming Language -->
      <InteractiveGlow client:load className="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span class="material-symbols-outlined text-[16px]">language</span> Languages
        </h3>
        <div class="space-y-6">
          {
            languageSkills.map((skill) => (
              <div>
                <div class="mb-2 flex justify-between">
                  <span>{skill.name}</span>
                  <span class="font-mono text-on-surface-variant">
                    {skill.level}%
                  </span>
                </div>
                <div class="h-1 overflow-hidden rounded-full bg-outline-variant/30">
                  <div
                    class="h-full bg-primary"
                    style={`width: ${skill.level}%`}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </InteractiveGlow>

      <!-- Category: AI Skills -->
      <InteractiveGlow client:load className="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span class="material-symbols-outlined text-[16px]">data_object</span> AI
          & Data
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            aiDataSkills.map((skill) => (
              <span class="tech-chip rounded-full px-3 py-1 text-sm">
                {skill}
              </span>
            ))
          }
        </div>
      </InteractiveGlow>

      <!-- Category: Frontend -->
      <InteractiveGlow client:load className="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span class="material-symbols-outlined text-[16px]">brush</span>
          Frontend
        </h3>

        <div class="space-y-4">
          {
            frontendSkills.map((skill) => (
              <div class="flex items-center gap-3">
                <div class="h-2 w-2 rounded-full bg-primary" />
                <span>{skill}</span>
              </div>
            ))
          }
        </div>
      </InteractiveGlow>

      <!-- Category: DevOps -->
      <InteractiveGlow client:load className="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span class="material-symbols-outlined text-[16px]">
            settings_system_daydream
          </span>
          Cloud &amp; DevOps
        </h3>

        <div class="space-y-4">
          {
            devopsSkills.map((skill) => (
              <div class="flex items-center justify-between rounded-lg border border-outline-variant/10 bg-background/50 p-3">
                <span>{skill}</span>
                <span class="material-symbols-outlined text-primary">
                  check_circle
                </span>
              </div>
            ))
          }
        </div>
      </InteractiveGlow>
    </div>
  </div>
</Reveal>
