---
import Reveal from "./Reveal.astro";
import {
  languageSkills,
  dataAutomationSkills,
  frameworkSkills,
  toolSkills,
} from "../data/skills";
---

<Reveal id="skills" class="border-b-[3px] border-ink bg-paper py-20 sm:py-24">
  <div class="page-shell">
    <div class="mb-12 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="section-kicker bg-yellow">Toolkit / 04</p>
        <h2 class="font-display text-[clamp(2.5rem,11.5vw,4.5rem)] font-black uppercase leading-none">
          Tools with purpose.
        </h2>
      </div>
      <p class="max-w-md text-lg font-semibold leading-relaxed">
        A practical stack shaped by the systems I have designed, integrated, and delivered.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-12">
      <article class="brutal-card overflow-hidden lg:col-span-7">
        <header class="border-b-[3px] border-ink bg-yellow p-5 sm:p-6">
          <p class="font-mono text-xs font-bold uppercase tracking-wider">Core languages</p>
          <h3 class="mt-1 font-display text-3xl font-black uppercase">Code I work in</h3>
        </header>
        <ul class="divide-y-[3px] divide-ink">
          {
            languageSkills.map((skill) => (
              <li class="grid gap-2 bg-white p-5 sm:grid-cols-[9rem_1fr] sm:items-center sm:p-6">
                <strong class="font-display text-xl font-black">{skill.name}</strong>
                <span class="font-mono text-sm font-medium leading-relaxed">{skill.appliedIn}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="brutal-card self-start overflow-hidden lg:col-span-5">
        <header class="border-b-[3px] border-ink bg-coral p-5 sm:p-6">
          <p class="font-mono text-xs font-bold uppercase tracking-wider">AI &amp; automation</p>
          <h3 class="mt-1 font-display text-3xl font-black uppercase">Intelligent systems</h3>
        </header>
        <ul class="flex flex-wrap gap-3 bg-white p-6">
          {dataAutomationSkills.map((skill) => <li class="brutal-chip bg-paper">{skill}</li>)}
        </ul>
      </article>

      <article class="brutal-card overflow-hidden lg:col-span-6">
        <header class="border-b-[3px] border-ink bg-blue p-5 text-white sm:p-6">
          <p class="font-mono text-xs font-bold uppercase tracking-wider">Frameworks</p>
          <h3 class="mt-1 font-display text-3xl font-black uppercase">Product delivery</h3>
        </header>
        <ul class="grid grid-cols-1 bg-white sm:grid-cols-2">
          {
            frameworkSkills.map((skill, index) => (
              <li
                class:list={[
                  "flex min-h-14 items-center border-ink px-5 py-3 font-bold",
                  index < frameworkSkills.length - 1 && "border-b-2",
                  index % 2 === 0 && "sm:border-r-2",
                  index === frameworkSkills.length - 2 && "sm:border-b-0",
                ]}
              >
                <span class="mr-3 font-mono text-blue" aria-hidden="true">#</span>
                {skill}
              </li>
            ))
          }
        </ul>
      </article>

      <article class="brutal-card overflow-hidden lg:col-span-6">
        <header class="border-b-[3px] border-ink bg-ink p-5 text-white sm:p-6">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-yellow">Platforms</p>
          <h3 class="mt-1 font-display text-3xl font-black uppercase">Build &amp; operations</h3>
        </header>
        <ul class="grid grid-cols-1 bg-white sm:grid-cols-2">
          {
            toolSkills.map((skill, index) => (
              <li
                class:list={[
                  "flex min-h-14 items-center border-ink px-5 py-3 font-bold",
                  index < toolSkills.length - 2 && "border-b-2",
                  index % 2 === 0 && "sm:border-r-2",
                ]}
              >
                <span class="mr-3 h-3 w-3 shrink-0 border-2 border-ink bg-coral" aria-hidden="true"></span>
                {skill}
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</Reveal>
