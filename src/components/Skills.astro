---
import Reveal from "./Reveal.astro";
import GlowCard from "./GlowCard.astro";
import {
  languageSkills,
  aiDataSkills,
  frontendSkills,
  devopsSkills,
} from "../data/skills";
---

<Reveal id="skills" class="bg-surface-container-lowest/50 py-12">
  <div class="mx-auto max-w-[1200px] px-5 md:px-16">
    <h2
      class="mb-12 text-center font-display text-4xl font-semibold tracking-[-0.02em]"
    >
      Engineering Dashboard
    </h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <GlowCard class="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span
            class="material-symbols-outlined text-[16px]"
            aria-hidden="true">language</span
          > Languages
        </h3>
        <div class="space-y-4">
          {
            languageSkills.map((skill) => (
              <div class="rounded-2xl border border-outline-variant/30 bg-surface-container-low/40 p-4 transition duration-300 hover:border-primary/40 hover:bg-surface-container-low">
                <div class="mb-2 flex items-center justify-between">
                  <span class="font-semibold text-on-surface">
                    {skill.name}
                  </span>
                </div>

                <p class="text-sm leading-relaxed text-on-surface-variant">
                  {skill.appliedIn}
                </p>
              </div>
            ))
          }
        </div>
      </GlowCard>

      <GlowCard class="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span
            class="material-symbols-outlined text-[16px]"
            aria-hidden="true">data_object</span
          > AI
          & Data
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            aiDataSkills.map((skill) => (
              <span class="tech-chip rounded-full px-3 py-1 text-sm">
                {skill}
              </span>
            ))
          }
        </div>
      </GlowCard>

      <GlowCard class="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span
            class="material-symbols-outlined text-[16px]"
            aria-hidden="true">brush</span
          >
          Frontend
        </h3>

        <div class="space-y-4">
          {
            frontendSkills.map((skill) => (
              <div class="flex items-center gap-3">
                <div class="h-2 w-2 rounded-full bg-primary" />
                <span>{skill}</span>
              </div>
            ))
          }
        </div>
      </GlowCard>

      <GlowCard class="glass rounded-2xl p-6">
        <h3
          class="mb-6 flex items-center gap-2 font-mono text-sm uppercase tracking-widest text-primary"
        >
          <span
            class="material-symbols-outlined text-[16px]"
            aria-hidden="true"
          >
            settings_system_daydream
          </span>
          Cloud &amp; DevOps
        </h3>

        <div class="space-y-4">
          {
            devopsSkills.map((skill) => (
              <div class="flex items-center justify-between rounded-lg border border-outline-variant/10 bg-background/50 p-3">
                <span>{skill}</span>
                <span
                  class="material-symbols-outlined text-primary"
                  aria-hidden="true"
                >
                  check_circle
                </span>
              </div>
            ))
          }
        </div>
      </GlowCard>
    </div>
  </div>
</Reveal>
