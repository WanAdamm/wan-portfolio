---
import Reveal from "./Reveal.astro";
import { site } from "../data/site";
---

<Reveal id="contact" class="border-b-[3px] border-ink bg-yellow py-20 sm:py-24">
  <div class="page-shell grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-6">
      <p class="section-kicker bg-white">Contact / 06</p>
      <h2 class="font-display text-[clamp(2.5rem,11.5vw,4.5rem)] font-black uppercase leading-[0.9]">
        Let's build something useful.
      </h2>
      <p class="mt-7 max-w-xl text-lg font-semibold leading-relaxed">
        {site.availability.detail} I am especially interested in AI, backend,
        automation, and full-stack product teams.
      </p>

      <div class="mt-8 border-[3px] border-ink bg-coral p-6 shadow-[6px_6px_0_#111]">
        <p class="font-mono text-xs font-bold uppercase tracking-wider">Email me directly</p>
        <a class="text-link mt-2 inline-block break-all text-lg sm:text-xl" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>

      <nav class="mt-8 flex flex-wrap gap-4" aria-label="Social profiles">
        <a
          class="brutal-button bg-white"
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub <span aria-hidden="true">-&gt;</span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <a
          class="brutal-button brutal-button--blue"
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn <span aria-hidden="true">-&gt;</span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </nav>
    </div>

    <form
      class="brutal-card min-w-0 space-y-5 bg-white p-6 sm:p-8 lg:col-span-6"
      name="contact"
      action={`mailto:${site.email}`}
      method="get"
      autocomplete="on"
      data-contact-form
      data-mailto={`mailto:${site.email}`}
    >
      <div>
        <p class="font-mono text-xs font-bold uppercase tracking-wider text-blue">Project inquiry</p>
        <h3 class="mt-1 font-display text-3xl font-black uppercase">Open an email draft</h3>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="mb-2 block font-mono text-xs font-bold uppercase">Full name</span>
          <input
            class="min-h-12 w-full border-[3px] border-ink bg-paper p-3 text-base font-medium placeholder:text-ink/65 focus:bg-white"
            placeholder="Your name"
            type="text"
            name="fullName"
            autocomplete="name"
            required
          />
        </label>
        <label class="block">
          <span class="mb-2 block font-mono text-xs font-bold uppercase">Email</span>
          <input
            class="min-h-12 w-full border-[3px] border-ink bg-paper p-3 text-base font-medium placeholder:text-ink/65 focus:bg-white"
            placeholder="you@example.com"
            type="email"
            name="email"
            autocomplete="email"
            required
          />
        </label>
      </div>

      <label class="block">
        <span class="mb-2 block font-mono text-xs font-bold uppercase">Subject</span>
        <input
          class="min-h-12 w-full border-[3px] border-ink bg-paper p-3 text-base font-medium placeholder:text-ink/65 focus:bg-white"
          placeholder="Software engineering opportunity"
          type="text"
          name="subject"
          required
        />
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs font-bold uppercase">Message</span>
        <textarea
          class="min-h-36 w-full resize-y border-[3px] border-ink bg-paper p-3 text-base font-medium placeholder:text-ink/65 focus:bg-white"
          placeholder="Tell me about the role, project, or problem."
          rows="5"
          name="message"
          required></textarea>
      </label>

      <p class="text-sm font-medium" id="contact-help">
        Submitting opens a pre-filled draft in your default email application.
      </p>

      <noscript>
        <p class="border-2 border-ink bg-yellow p-3 text-sm font-bold">
          JavaScript is unavailable. Use the direct email link beside this form instead.
        </p>
      </noscript>

      <button class="brutal-button brutal-button--coral w-full" type="submit" aria-describedby="contact-help">
        Prepare email <span aria-hidden="true">-&gt;</span>
      </button>

      <p class="min-h-6 font-mono text-sm font-bold" aria-live="polite" data-contact-status></p>
    </form>
  </div>
</Reveal>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach(
    (form) => {
      form.addEventListener("submit", (event) => {
        event.preventDefault();

        if (!form.reportValidity()) return;

        const formData = new FormData(form);
        const value = (field: string) =>
          String(formData.get(field) ?? "").trim();
        const body = [
          "Hi Wan,",
          "",
          value("message").replace(/\r\n|\r|\n/g, "\r\n"),
          "",
          `From: ${value("fullName")}`,
          `Reply to: ${value("email")}`,
        ].join("\r\n");
        const status = form.querySelector<HTMLElement>("[data-contact-status]");

        if (status) status.textContent = "Opening your email application...";
        window.location.href = `${form.dataset.mailto}?subject=${encodeURIComponent(value("subject"))}&body=${encodeURIComponent(body)}`;
      });
    },
  );
</script>
