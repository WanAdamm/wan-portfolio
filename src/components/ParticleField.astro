<particle-field
  class="pointer-events-none absolute inset-0 z-[1] block"
  aria-hidden="true"
>
  <canvas class="h-full w-full"></canvas>
</particle-field>

<script>
  type Particle = {
    x: number;
    y: number;
    size: number;
    speedX: number;
    speedY: number;
    opacity: number;
  };

  class ParticleFieldElement extends HTMLElement {
    private canvas: HTMLCanvasElement;
    private context: CanvasRenderingContext2D;
    private particles: Particle[] = [];
    private frame: number | null = null;
    private resizeFrame: number | null = null;
    private width = 0;
    private height = 0;
    private isVisible = true;
    private mouse = { x: null as number | null, y: null as number | null };
    private motionPreference = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    private visibilityObserver?: IntersectionObserver;
    private resizeObserver?: ResizeObserver;

    constructor() {
      super();

      const canvas = this.querySelector("canvas");
      const context = canvas?.getContext("2d");

      if (!canvas || !context) {
        throw new Error("Particle field requires a canvas element.");
      }

      this.canvas = canvas;
      this.context = context;
    }

    connectedCallback() {
      this.resize();

      this.resizeObserver = new ResizeObserver(this.scheduleResize);
      this.resizeObserver.observe(this);

      this.visibilityObserver = new IntersectionObserver(([entry]) => {
        this.isVisible = entry.isIntersecting;
        this.syncAnimation();
      });
      this.visibilityObserver.observe(this);

      this.motionPreference.addEventListener("change", this.syncAnimation);
      window.addEventListener("pointermove", this.handlePointerMove, {
        passive: true,
      });
      document.addEventListener("visibilitychange", this.syncAnimation);
      this.syncAnimation();
    }

    disconnectedCallback() {
      this.stopAnimation();
      this.resizeObserver?.disconnect();
      this.visibilityObserver?.disconnect();
      this.motionPreference.removeEventListener("change", this.syncAnimation);
      window.removeEventListener("pointermove", this.handlePointerMove);
      document.removeEventListener("visibilitychange", this.syncAnimation);

      if (this.resizeFrame !== null) {
        cancelAnimationFrame(this.resizeFrame);
        this.resizeFrame = null;
      }
    }

    private scheduleResize = () => {
      if (this.resizeFrame !== null) return;

      this.resizeFrame = requestAnimationFrame(() => {
        this.resizeFrame = null;
        this.resize();
      });
    };

    private resize = () => {
      const bounds = this.getBoundingClientRect();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      this.width = Math.max(1, Math.round(bounds.width));
      this.height = Math.max(1, Math.round(bounds.height));
      this.canvas.width = Math.round(this.width * pixelRatio);
      this.canvas.height = Math.round(this.height * pixelRatio);
      this.context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

      const particleCount = Math.min(
        160,
        Math.floor((this.width * this.height) / 15000),
      );

      this.particles = Array.from({ length: particleCount }, () => ({
        x: Math.random() * this.width,
        y: Math.random() * this.height,
        size: Math.random() * 1.5 + 0.5,
        speedX: (Math.random() - 0.5) * 0.2,
        speedY: (Math.random() - 0.5) * 0.2,
        opacity: Math.random() * 0.4 + 0.1,
      }));
    };

    private handlePointerMove = (event: PointerEvent) => {
      if (!this.isVisible) return;

      const bounds = this.getBoundingClientRect();
      const x = event.clientX - bounds.left;
      const y = event.clientY - bounds.top;

      if (x < 0 || y < 0 || x > bounds.width || y > bounds.height) {
        this.mouse = { x: null, y: null };
        return;
      }

      this.mouse = { x, y };
    };

    private syncAnimation = () => {
      const shouldAnimate =
        !this.motionPreference.matches && this.isVisible && !document.hidden;

      if (shouldAnimate && this.frame === null) {
        this.frame = requestAnimationFrame(this.drawFrame);
      } else if (!shouldAnimate) {
        this.stopAnimation();

        if (this.motionPreference.matches) {
          this.context.clearRect(0, 0, this.width, this.height);
        }
      }
    };

    private stopAnimation = () => {
      if (this.frame === null) return;
      cancelAnimationFrame(this.frame);
      this.frame = null;
    };

    private drawFrame = () => {
      this.context.clearRect(0, 0, this.width, this.height);

      this.particles.forEach((particle) => {
        particle.x += particle.speedX;
        particle.y += particle.speedY;

        if (this.mouse.x !== null && this.mouse.y !== null) {
          const distanceX = this.mouse.x - particle.x;
          const distanceY = this.mouse.y - particle.y;
          const distance = Math.hypot(distanceX, distanceY);

          if (distance < 150) {
            particle.x -= distanceX / 50;
            particle.y -= distanceY / 50;
          }
        }

        if (particle.x < 0) particle.x = this.width;
        if (particle.x > this.width) particle.x = 0;
        if (particle.y < 0) particle.y = this.height;
        if (particle.y > this.height) particle.y = 0;

        this.context.fillStyle = `rgb(173 198 255 / ${particle.opacity})`;
        this.context.beginPath();
        this.context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
        this.context.fill();
      });

      this.frame = requestAnimationFrame(this.drawFrame);
    };
  }

  if (!customElements.get("particle-field")) {
    customElements.define("particle-field", ParticleFieldElement);
  }
</script>
