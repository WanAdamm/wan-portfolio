---
import Reveal from "./Reveal.astro";
---

<Reveal id="about" class="mx-auto max-w-[1200px] px-5 py-12 md:px-16">
  <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-2">
    <div class="space-y-6">
      <h2 class="font-display text-4xl font-semibold tracking-[-0.02em] text-primary">Intelligent Systems & Execution</h2>
      <p class="text-lg leading-relaxed text-on-surface-variant">
        I am a driven Computer Science undergraduate specializing in Intelligent Computing. My focus lies at the intersection of robust system design and machine learning integration. I transform complex problems into scalable full-stack solutions.
      </p>

      <div class="flex gap-4">
        <div class="glass flex-1 rounded-xl p-6 text-center transition hover:border-primary/30">
          <p class="font-display text-4xl font-semibold text-primary">3.75</p>
          <p class="font-mono text-sm uppercase text-on-surface-variant">CGPA</p>
        </div>
        <div class="glass flex-1 rounded-xl p-6 text-center transition hover:border-primary/30">
          <p class="font-display text-4xl font-semibold text-primary">5+</p>
          <p class="font-mono text-sm uppercase text-on-surface-variant">Dean's List</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="glass rounded-2xl p-8 transition hover:-translate-y-1 hover:border-primary/50">
        <span class="material-symbols-outlined mb-4 text-4xl text-primary">groups</span>
        <h3 class="mb-2 font-display text-2xl font-semibold">Leadership</h3>
        <p class="text-on-surface-variant">Able to lead teams, coordinate stakeholders, and deliver under pressure.</p>
      </div>

      <div class="glass rounded-2xl p-8 transition hover:-translate-y-1 hover:border-primary/50">
        <span class="material-symbols-outlined mb-4 text-4xl text-primary">terminal</span>
        <h3 class="mb-2 font-display text-2xl font-semibold">Technical Depth</h3>
        <p class="text-on-surface-variant">Strong foundation across AI, full-stack engineering, databases, and tooling.</p>
      </div>
    </div>
  </div>
</Reveal>