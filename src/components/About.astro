---
import Reveal from "./Reveal.astro";
---

<Reveal id="about" class="mx-auto max-w-[1200px] px-5 py-12 md:px-16">
  <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-2">
    <div class="space-y-6">
      <h2 class="font-display text-4xl font-semibold tracking-[-0.02em] text-primary">Industry Experience &amp; Practical Execution</h2>
      <p class="text-lg leading-relaxed text-on-surface-variant text-justify">
        I am a final-year Computer Science student specializing in Intelligent Computing and an early-career software engineer with backend experience at B. Braun. I build practical systems across data science, automation, and full-stack development by turning requirements into maintainable architecture and reliable solutions. Working with enterprise integrations and multi-agent AI has strengthened how I collaborate, communicate tradeoffs, and deliver in professional environments.
      </p>

      <div class="flex gap-4">
        <div class="glass flex-1 rounded-xl p-6 text-center transition hover:border-primary/30">
          <p class="font-display text-4xl font-semibold text-primary">3.75</p>
          <p class="font-mono text-sm uppercase text-on-surface-variant">CGPA</p>
        </div>
        <div class="glass flex-1 rounded-xl p-6 text-center transition hover:border-primary/30">
          <p class="font-display text-4xl font-semibold text-primary">5</p>
          <p class="font-mono text-sm uppercase text-on-surface-variant">Dean's List</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="glass rounded-2xl p-8 transition hover:-translate-y-1 hover:border-primary/50">
        <span
          class="material-symbols-outlined mb-4 text-4xl text-primary"
          aria-hidden="true">groups</span
        >
        <h3 class="mb-2 font-display text-2xl font-semibold">Collaborative Engineering</h3>
        <p class="text-on-surface-variant">Experienced in clarifying requirements, communicating tradeoffs, and coordinating with technical stakeholders.</p>
      </div>

      <div class="glass rounded-2xl p-8 transition hover:-translate-y-1 hover:border-primary/50">
        <span
          class="material-symbols-outlined mb-4 text-4xl text-primary"
          aria-hidden="true">terminal</span
        >
        <h3 class="mb-2 font-display text-2xl font-semibold">Production Mindset</h3>
        <p class="text-on-surface-variant">Focused on reliable APIs, cloud services, enterprise integrations, and maintainable end-to-end delivery.</p>
      </div>
    </div>
  </div>
</Reveal>
