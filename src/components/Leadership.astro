---
import Reveal from "./Reveal.astro";

const experiences = [
  {
    title: "MPDIK Leadership",
    description:
      "Led an 8-member division across logistics, budgeting, stakeholder communication, and mentoring, improving coordination for university programs with 30 to 50 participants.",
    tags: ["Team leadership", "Resource management"],
  },
  {
    title: "Computer Science Society",
    description:
      "Directed logistics, AV systems, and venue operations for flagship events including international hackathon VHACK and PIXEL, supporting hundreds of participants while contributing to the society's website.",
    tags: ["Technical operations", "Event execution"],
  },
];
---

<Reveal id="leadership" class="border-b-[3px] border-ink bg-coral py-20 sm:py-24">
  <div class="page-shell">
    <div class="mb-12 grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="min-w-0 lg:col-span-8">
        <p class="section-kicker bg-white">Leadership / 05</p>
        <h2 class="font-display text-[clamp(2.5rem,11.5vw,4.5rem)] font-black uppercase leading-none">
          Ownership beyond code.
        </h2>
      </div>
      <p class="min-w-0 max-w-lg text-lg font-semibold leading-relaxed lg:col-span-4">
        Coordinating people, resources, technical operations, and high-pressure delivery.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 md:pb-8">
      {
        experiences.map((item, index) => (
          <article class:list={["brutal-card min-w-0 overflow-hidden", index === 1 && "md:translate-y-8"]}>
            <div class:list={["border-b-[3px] border-ink p-5", index === 0 ? "bg-yellow" : "bg-blue text-white"]}>
              <p class="font-mono text-xs font-bold uppercase tracking-wider">
                Leadership record {String(index + 1).padStart(2, "0")}
              </p>
            </div>
            <div class="bg-white p-7 sm:p-8">
              <h3 class="font-display text-3xl font-black uppercase">{item.title}</h3>
              <p class="mt-4 font-medium leading-relaxed">{item.description}</p>
              <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${item.title} focus areas`}>
                {item.tags.map((tag) => <li class="brutal-chip bg-paper">{tag}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Reveal>
