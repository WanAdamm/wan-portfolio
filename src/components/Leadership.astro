---
import Reveal from "./Reveal.astro";

const experiences = [
  {
    title: "MPDIK Leadership",
    icon: "account_balance",
    description:
      "Led an 8-member division across logistics, budgeting, stakeholder communication, and mentoring, improving coordination for university programs with 30 to 50 participants.",
    tags: "TEAM LEADERSHIP | RESOURCE MANAGEMENT",
  },
  {
    title: "Computer Science Society",
    icon: "terminal",
    description:
      "Directed logistics, AV systems, and venue operations for flagship events including international hackathon VHACK and PIXEL, supporting hundreds of participants while contributing to the society's website.",
    tags: "TECHNICAL OPERATIONS | EVENT EXECUTION",
  },
];
---

<Reveal id="leadership" class="bg-surface-container-low/30 py-12">
  <div class="mx-auto max-w-[1200px] px-5 md:px-16">
    <div
      class="mb-12 flex flex-col justify-between gap-4 md:flex-row md:items-end"
    >
      <div>
        <h2 class="font-display text-4xl font-semibold tracking-[-0.02em]">
          Leadership &amp; Delivery
        </h2>
        <p class="text-lg text-on-surface-variant">
          Taking ownership across teams, stakeholders, and high-pressure delivery.
        </p>
      </div>
      <span
        class="rounded-full bg-primary/10 px-4 py-2 font-mono text-sm text-primary"
        >TEAMWORK &amp; EXECUTION</span
      >
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        experiences.map((item) => (
          <article class="glass rounded-2xl p-8 transition hover:-translate-y-1 hover:border-primary">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <span class="material-symbols-outlined" aria-hidden="true"
                >{item.icon}</span
              >
            </div>
            <h3 class="mb-2 font-display text-2xl font-semibold">
              {item.title}
            </h3>
            <p class="mb-4 text-on-surface-variant">{item.description}</p>
            <p class="font-mono text-xs text-primary">{item.tags}</p>
          </article>
        ))
      }
    </div>
  </div>
</Reveal>
