---
const links = [
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Leadership", href: "#leadership" },
  { label: "Timeline", href: "#timeline" },
];

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const resumeUrl = `${base}resume.pdf`;

---

<header
  class="fixed top-0 z-50 w-full border-b border-outline-variant/20 bg-surface/80 shadow-sm backdrop-blur-xl"
>
  <nav
    class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-5 md:px-16"
  >
    <a href="#" class="flex items-center gap-3">
      <div
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-background font-display font-bold"
      >
        WA
      </div>
      <span
        class="font-display text-2xl font-bold tracking-tight text-on-surface"
        >Wan Muhammad Adam</span
      >
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            class="text-on-surface-variant transition hover:text-primary"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="rounded-full bg-on-surface px-5 py-2 font-bold text-background transition hover:scale-95"
        href={resumeUrl}>Resume</a
      >
    </div>

    <button class="md:hidden text-on-surface" aria-label="Open navigation menu">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </nav>
</header>
