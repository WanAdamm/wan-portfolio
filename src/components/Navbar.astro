---
import { navigation, site } from "../data/site";
---

<header
  class="fixed top-0 z-50 w-full border-b border-outline-variant/20 bg-surface/80 shadow-sm backdrop-blur-xl"
>
  <nav
    class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-5 md:px-16"
    aria-label="Primary navigation"
  >
    <a href="#top" class="flex min-w-0 items-center gap-3">
      <div
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-background font-display font-bold"
      >
        WA
      </div>
      <span
        class="truncate font-display text-lg font-bold tracking-tight text-on-surface sm:text-xl"
        >Wan Muhammad Adam</span
      >
    </a>

    <div class="hidden items-center gap-6 lg:flex xl:gap-8">
      {
        navigation.map((link) => (
          <a
            class="text-on-surface-variant transition hover:text-primary"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="rounded-full bg-on-surface px-5 py-2 font-bold text-background transition hover:scale-95"
        href={site.resumeUrl}
        target="_blank"
        rel="noopener noreferrer">Resume</a
      >
    </div>

    <details class="group relative shrink-0 lg:hidden" data-mobile-nav>
      <summary
        class="flex h-10 w-10 list-none items-center justify-center rounded-lg text-on-surface transition hover:bg-surface-container-low [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined group-open:hidden" aria-hidden="true"
          >menu</span
        >
        <span
          class="material-symbols-outlined hidden group-open:inline"
          aria-hidden="true">close</span
        >
      </summary>

      <div
        id="mobile-navigation"
        class="glass absolute right-0 top-12 w-64 rounded-2xl p-3 shadow-2xl"
      >
        <div class="flex flex-col gap-1">
          {
            navigation.map((link) => (
              <a
                class="rounded-lg px-4 py-3 text-on-surface-variant transition hover:bg-surface-container-low hover:text-primary"
                href={link.href}
              >
                {link.label}
              </a>
            ))
          }
          <a
            class="mt-2 rounded-lg bg-on-surface px-4 py-3 text-center font-bold text-background"
            href={site.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            View Resume
          </a>
        </div>
      </div>
    </details>
  </nav>
</header>

<script>
  const mobileNavigations = document.querySelectorAll<HTMLDetailsElement>(
    "[data-mobile-nav]",
  );

  mobileNavigations.forEach((details) => {
    const summary = details.querySelector("summary");

    details.addEventListener("toggle", () => {
      summary?.setAttribute("aria-expanded", String(details.open));
    });

    details.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        details.open = false;
      });
    });
  });

  document.addEventListener("pointerdown", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;

    mobileNavigations.forEach((details) => {
      if (!details.contains(target)) details.open = false;
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    mobileNavigations.forEach((details) => {
      if (!details.open) return;
      details.open = false;
      details.querySelector("summary")?.focus();
    });
  });
</script>
