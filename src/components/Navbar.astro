---
import { navigation, site } from "../data/site";
---

<header class="fixed top-0 z-50 w-full border-b-[3px] border-ink bg-paper">
  <nav
    class="page-shell flex min-h-[4.75rem] items-center justify-between gap-4"
    aria-label="Primary navigation"
  >
    <a href="#top" class="group flex min-w-0 items-center gap-3 no-underline">
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center border-[3px] border-ink bg-blue font-display text-sm font-black text-white shadow-[3px_3px_0_#111] transition-transform group-hover:-translate-y-0.5"
        aria-hidden="true"
      >
        WA
      </span>
      <span class="hidden truncate font-display text-lg font-black uppercase leading-none sm:block">
        Wan Muhammad Adam
      </span>
      <span class="truncate font-display text-lg font-black uppercase sm:hidden">Wan Adam</span>
    </a>

    <div class="hidden items-center gap-5 lg:flex">
      {
        navigation.map((link) => (
          <a
            class="inline-flex min-h-11 items-center font-mono text-xs font-bold uppercase underline decoration-2 underline-offset-4 hover:decoration-4"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="brutal-button brutal-button--yellow min-h-11 px-4 py-2 text-sm"
        href={site.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Resume <span aria-hidden="true">-&gt;</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>

    <details class="group relative shrink-0 lg:hidden" data-mobile-nav>
      <summary
        class="flex min-h-11 min-w-20 cursor-pointer list-none items-center justify-center border-[3px] border-ink bg-yellow px-3 font-mono text-xs font-bold uppercase shadow-[3px_3px_0_#111] [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>

      <div
        id="mobile-navigation"
        class="absolute right-0 top-14 max-h-[calc(100svh-5.5rem)] w-72 max-w-[calc(100vw-2rem)] overflow-y-auto overscroll-contain border-[3px] border-ink bg-coral p-3 shadow-[6px_6px_0_#111]"
      >
        <div class="flex flex-col gap-2">
          {
            navigation.map((link) => (
              <a
                class="flex min-h-12 items-center border-2 border-ink bg-white px-4 font-mono text-sm font-bold uppercase no-underline hover:bg-yellow"
                href={link.href}
              >
                {link.label}
              </a>
            ))
          }
          <a
            class="brutal-button brutal-button--yellow mt-1"
            href={site.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            View Resume <span aria-hidden="true">-&gt;</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </details>
  </nav>
</header>

<script>
  const mobileNavigations = document.querySelectorAll<HTMLDetailsElement>(
    "[data-mobile-nav]",
  );

  mobileNavigations.forEach((details) => {
    const summary = details.querySelector("summary");

    details.addEventListener("toggle", () => {
      summary?.setAttribute("aria-expanded", String(details.open));
    });

    details.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", () => {
        const destination = link.hash
          ? document.querySelector<HTMLElement>(link.hash)
          : null;
        const destinationHeading =
          destination?.querySelector<HTMLElement>("h1, h2") ?? destination;

        details.open = false;

        if (destinationHeading) {
          destinationHeading.setAttribute("tabindex", "-1");
          requestAnimationFrame(() => {
            destinationHeading.focus({ preventScroll: true });
          });
        }
      });
    });
  });

  document.addEventListener("pointerdown", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;

    mobileNavigations.forEach((details) => {
      if (!details.contains(target)) details.open = false;
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    mobileNavigations.forEach((details) => {
      if (!details.open) return;
      details.open = false;
      details.querySelector("summary")?.focus();
    });
  });
</script>
