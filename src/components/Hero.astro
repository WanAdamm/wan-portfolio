---
import { site } from "../data/site";

const focusAreas = ["AI systems", "Backend engineering", "Full-stack delivery"];
const technologies = ["Python", "Java", "Azure", "React", "Docker"];
---

<section
  id="top"
  class="relative overflow-hidden border-b-[3px] border-ink bg-paper pb-16 pt-28 sm:pb-20 sm:pt-36 lg:pt-52 2xl:pt-36"
>
  <!-- Malaysian Flag -->
  <div
    class="absolute right-[-2.5rem] top-28 h-28 w-28 overflow-hidden border-[3px] border-ink sm:right-20 sm:h-40 sm:w-40 2xl:top-28 2xl:h-40 2xl:w-40"
    aria-hidden="true"
  >
    <svg class="block h-full w-full" viewBox="0 0 140 140" focusable="false">
      <rect width="140" height="140" fill="#fff"></rect>
      <g fill="#cc0001">
        <rect width="140" height="10"></rect>
        <rect y="20" width="140" height="10"></rect>
        <rect y="40" width="140" height="10"></rect>
        <rect y="60" width="140" height="10"></rect>
        <rect y="80" width="140" height="10"></rect>
        <rect y="100" width="140" height="10"></rect>
        <rect y="120" width="140" height="10"></rect>
      </g>
      <rect width="72" height="80" fill="#010066"></rect>
      <circle cx="25" cy="40" r="19" fill="#ffcc00"></circle>
      <circle cx="31.5" cy="40" r="15.5" fill="#010066"></circle>
      <polygon
        fill="#ffcc00"
        points="57.00,27.00 58.22,34.64 62.64,28.29 60.43,35.70 67.16,31.89 61.96,37.61 69.67,37.11 62.50,40.00 69.67,42.89 61.96,42.39 67.16,48.11 60.43,44.30 62.64,51.71 58.22,45.36 57.00,53.00 55.78,45.36 51.36,51.71 53.57,44.30 46.84,48.11 52.04,42.39 44.33,42.89 51.50,40.00 44.33,37.11 52.04,37.61 46.84,31.89 53.57,35.70 51.36,28.29 55.78,34.64"
      ></polygon>
    </svg>
  </div>

  <div class="page-shell relative">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="min-w-0 lg:col-span-7">
        <p class="section-kicker bg-yellow">Hello, I build useful software</p>
        <h1
          class="hero-name font-display text-[clamp(3.25rem,9vw,6.5rem)] font-black uppercase leading-[0.82] tracking-[-0.075em]"
        >
          <span class="block">Wan</span>
          <span
            class="my-2 block w-fit border-[3px] border-ink bg-blue px-2 pb-2 pt-1 text-white shadow-[6px_6px_0_#111] sm:px-4"
          >
            <span>Muhammad</span>
          </span>
          <span class="block pl-[12%]">Adam.</span>
        </h1>
      </div>

      <div class="relative min-w-0 lg:col-span-5 lg:pb-3">
        <div class="brutal-card min-w-0 bg-yellow p-6 sm:p-8">
          <p class="mb-3 font-mono text-xs font-bold uppercase tracking-[0.12em]">
            Software engineer / Final-year CS student
          </p>
          <p class="font-display text-2xl font-black leading-tight sm:text-3xl">
            Turning AI, backend, and product requirements into systems that work.
          </p>
          <p class="mt-5 max-w-xl text-base font-medium leading-relaxed">
            Intelligent Computing student at Universiti Sains Malaysia with
            hands-on enterprise experience in agentic AI, APIs, cloud services,
            automation, and full-stack delivery.
          </p>

          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Core technologies">
            {technologies.map((technology) => <li class="brutal-chip bg-white">{technology}</li>)}
          </ul>
        </div>

        <div class="mt-8 border-[3px] border-ink bg-coral p-4 shadow-[5px_5px_0_#111]">
          <p class="font-mono text-xs font-bold uppercase tracking-wider">Status</p>
          <p class="mt-1 font-display text-lg font-black">{site.availability.label}</p>
        </div>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="#projects" class="brutal-button brutal-button--blue w-full sm:w-auto">
            Explore my work
          </a>
          <a href="#contact" class="brutal-button w-full sm:w-auto">Start a conversation</a>
        </div>
      </div>
    </div>

    <ul
      class="mt-16 grid border-[3px] border-ink bg-ink sm:grid-cols-3"
      aria-label="Engineering focus areas"
    >
      {
        focusAreas.map((area, index) => (
          <li
            class:list={[
              "flex min-h-16 items-center justify-center px-4 py-3 text-center font-mono text-sm font-bold uppercase",
              index === 0 && "bg-yellow text-ink",
              index === 1 && "border-y-[3px] border-ink bg-white text-ink sm:border-x-[3px] sm:border-y-0",
              index === 2 && "bg-coral text-ink",
            ]}
          >
            {area}
          </li>
        ))
      }
    </ul>
  </div>
</section>
